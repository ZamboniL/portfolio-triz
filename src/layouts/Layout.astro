---
import Header, { type NavId } from '../components/Header.astro';
import '../styles/theme.css';

interface Props {
	title?: string;
	active?: NavId;
}

const { title = 'Beatriz Mendonça', active } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<Header active={active} />
		<main class="container">
			<slot />
		</main>
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

	body {
		/* Project-page phone screenshots bleed past the screen edge on mobile. */
		overflow-x: clip;
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-serif);
		font-size: var(--font-size-base);
		line-height: var(--line-height-normal);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	p {
		margin: 0;
	}

	.container {
		width: var(--container-width);
		max-width: 100%;
		margin: 0 auto;
	}

	@media (max-width: 999px) {
		.container {
			width: 350px;
			max-width: calc(100% - 2 * var(--layout-gutter));
		}
	}
</style>
