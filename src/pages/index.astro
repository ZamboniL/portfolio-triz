---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';

const featured = projects.slice(0, 6);
---

<Layout active="home">
	<p class="tagline">Creating, reading, writing and talking about all of it.</p>

	<div class="grid">
		{featured.map((project) => <ProjectCard project={project} />)}
	</div>

	<a class="view-all" href="/projects">
		View all
		<span class="view-all-icon" aria-hidden="true">
			<img src="/images/view-all-circle.svg" alt="" width="18" height="18" />
			<img class="view-all-arrow" src="/images/view-all-arrow.svg" alt="" width="4.18198" height="7.36396" />
		</span>
	</a>

	<div class="footer-wrap">
		<Footer />
	</div>
</Layout>

<style>
	.tagline {
		margin-top: var(--layout-page-top);
		/* Same line box as the 30px page titles, so the text sits on the same line as theirs. */
		line-height: var(--line-height-title);
		font-weight: var(--font-weight-light);
		font-style: italic;
		text-align: center;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 310px);
		column-gap: var(--space-2);
		margin-top: var(--layout-title-gap);
	}

	.view-all {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		width: fit-content;
		margin: calc(var(--space-1) * 60) var(--space-12) 0 auto;
		font-weight: var(--font-weight-light);
	}

	.view-all:hover {
		text-decoration: underline;
	}

	.view-all-icon {
		position: relative;
		display: block;
		width: 18px;
		height: 18px;
	}

	.view-all-icon img {
		position: absolute;
		top: 0;
		left: 0;
	}

	.view-all-icon .view-all-arrow {
		top: 5.32px;
		left: 7.57px;
	}

	.footer-wrap {
		margin: var(--layout-footer-gap) 0 0 var(--layout-footer-inset);
		padding-bottom: var(--layout-page-bottom);
	}

	@media (max-width: 999px) {
		.tagline {
			font-size: var(--font-size-md);
			line-height: var(--line-height-normal);
		}

		.grid {
			grid-template-columns: 100%;
			justify-items: center;
			row-gap: var(--space-10);
		}

		/* Mobile home shows only the first three projects. */
		.grid > :global(:nth-child(n + 4)) {
			display: none;
		}

		.view-all {
			margin: var(--space-12) 0 0 auto;
		}
	}
</style>
