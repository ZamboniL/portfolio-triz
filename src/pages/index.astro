---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';

const featured = projects.slice(0, 6);
---

<Layout active="home">
	<p class="tagline">Creating, reading, writing and talking about all of it.</p>

	<div class="grid">
		{featured.map((project) => <ProjectCard project={project} />)}
	</div>

	<a class="view-all" href="/projects">
		View all
		<span class="view-all-icon" aria-hidden="true">
			<img src="/images/view-all-circle.svg" alt="" width="18" height="18" />
			<img class="view-all-arrow" src="/images/view-all-arrow.svg" alt="" width="4.18198" height="7.36396" />
		</span>
	</a>

	<div class="footer-wrap">
		<Footer />
	</div>
</Layout>

<style>
	.tagline {
		margin-top: 165px;
		/* Same line box as the 30px page titles, so the text sits on the same line as theirs. */
		line-height: 37px;
		font-weight: 300;
		font-style: italic;
		text-align: center;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 310px);
		column-gap: 8px;
		margin-top: 82px;
	}

	.view-all {
		display: flex;
		align-items: center;
		gap: 10px;
		width: fit-content;
		margin: 243px 47px 0 auto;
		font-weight: 300;
	}

	.view-all:hover {
		text-decoration: underline;
	}

	.view-all-icon {
		position: relative;
		display: block;
		width: 18px;
		height: 18px;
	}

	.view-all-icon img {
		position: absolute;
		top: 0;
		left: 0;
	}

	.view-all-icon .view-all-arrow {
		top: 5.32px;
		left: 7.57px;
	}

	.footer-wrap {
		margin: 204px 0 0 49px;
		padding-bottom: 64px;
	}

	@media (max-width: 999px) {
		.tagline {
			margin-top: 88px;
			font-size: 16px;
			line-height: normal;
		}

		.grid {
			grid-template-columns: 100%;
			justify-items: center;
			row-gap: 39px;
			margin-top: 60px;
		}

		/* Mobile home shows only the first three projects. */
		.grid > :global(:nth-child(n + 4)) {
			display: none;
		}

		.view-all {
			margin: 47px 0 0 auto;
		}

		.footer-wrap {
			margin: 130px 0 0;
			padding-bottom: 68px;
		}
	}
</style>
