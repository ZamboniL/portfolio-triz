---
import Footer from '../components/Footer.astro';
import PageTitle from '../components/PageTitle.astro';
import SkillTag from '../components/SkillTag.astro';
import { about } from '../data/site';
import Layout from '../layouts/Layout.astro';

const { bio, education, skillRows } = about;
---

<Layout title="About · Beatriz Mendonça" active="about">
	<PageTitle color="red">About me</PageTitle>

	<section class="intro">
		<!-- Photo slot: placeholder until the real picture is added. -->
		<div class="picture" aria-hidden="true"></div>

		<div class="bio">
			{bio.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</section>

	<div class="details">
		<section class="education">
			<h2 class="heading">Education</h2>
			<ul class="education-list">
				{
					education.map((item) => (
						<li>
							<p class="education-title">{item.title}</p>
							<p class="education-years">{item.years}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section class="skills">
			<h2 class="heading">Skills</h2>
			<div class="skill-rows">
				{
					skillRows.map(({ skills }) => (
						<ul class="skill-row">
							{skills.map((skill) => (
								<li>
									<SkillTag label={skill.label} color={skill.color} />
								</li>
							))}
						</ul>
					))
				}
			</div>
		</section>
	</div>

	<div class="footer-wrap">
		<Footer />
	</div>
</Layout>

<style>
	.intro {
		display: flex;
		align-items: flex-start;
		margin-top: var(--space-32);
	}

	.picture {
		flex: none;
		width: 316px;
		height: 318px;
		border-radius: var(--radius-lg);
		background: var(--color-placeholder);
		box-shadow: var(--elevation-offset);
	}

	.bio {
		width: 481px;
		margin: var(--space-8) 0 0 var(--space-24);
		font-size: var(--font-size-copy);
		font-weight: var(--font-weight-light);
	}

	.bio p + p {
		margin-top: var(--space-6);
	}

	.details {
		display: grid;
		grid-template-columns: 621px 1fr;
		margin: calc(var(--space-1) * 29) 0 0 var(--space-2);
	}

	.heading {
		margin: 0;
		font-size: var(--font-size-title);
		font-weight: var(--font-weight-regular);
		font-style: italic;
	}

	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.education-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		margin-top: var(--space-5);
	}

	.education-title {
		font-weight: var(--font-weight-bold);
	}

	.education-years {
		margin-top: var(--space-1);
		font-weight: var(--font-weight-light);
		font-style: italic;
	}

	.skill-rows {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin-top: var(--space-5);
	}

	.skill-row {
		display: flex;
		gap: var(--space-3);
	}

	.footer-wrap {
		margin: var(--layout-footer-gap) 0 0 var(--layout-footer-inset);
		padding-bottom: var(--layout-page-bottom);
	}

	@media (max-width: 999px) {
		.intro {
			display: block;
			margin-top: var(--space-12);
		}

		/* Not in the mobile design. */
		.picture {
			display: none;
		}

		.bio {
			width: 340px;
			max-width: 100%;
			margin: 0 0 0 var(--layout-inset);
		}

		.bio p + p {
			margin-top: var(--space-4);
		}

		.details {
			display: block;
			margin: var(--space-12) 0 0 var(--layout-inset);
		}

		.heading {
			text-align: center;
		}

		.education-list {
			gap: var(--space-8);
			margin-top: var(--space-5);
		}

		.education-title {
			font-size: var(--font-size-md);
		}

		.education-years {
			margin-top: var(--space-2);
			font-size: var(--font-size-sm);
		}

		.skills {
			margin-top: var(--space-14);
		}

		.skill-rows {
			margin-top: var(--space-2);
			padding-left: var(--space-7);
		}
	}
</style>
