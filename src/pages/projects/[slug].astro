---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import PageTitle from '../../components/PageTitle.astro';
import { projects, getProjectPage, type Project } from '../../data/projects';

export const getStaticPaths = (() =>
	projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

interface Props {
	project: Project;
}

const { project } = Astro.props;
const page = getProjectPage(project);
---

<Layout title={`${project.title} · Beatriz Mendonça`} active="projects">
	<PageTitle color={page.accent ?? 'purple'}>{project.title}</PageTitle>

	<p class="text intro">{page.intro}</p>

	{
		page.screens && (
			<div class="showcase">
				{page.screens.map((src, i) => (
					<img class={`phone phone-${i + 1}`} src={src} alt="" width="1920" height="1784" />
				))}
			</div>
		)
	}

	<p class="text body">{page.body}</p>

	<!-- Photo slots: placeholders until the real images are added. -->
	<div class="gallery" aria-hidden="true">
		<span class="slot slot-a"></span>
		<span class="slot slot-b"></span>
		<span class="slot slot-c"></span>
	</div>

	<div class="footer-wrap">
		<Footer />
	</div>
</Layout>

<style>
	.text {
		width: 878px;
		max-width: 100%;
		margin-left: var(--layout-inset);
		font-size: var(--font-size-copy);
		font-weight: var(--font-weight-light);
	}

	.intro {
		margin-top: var(--layout-title-gap);
	}

	/* White panel with three phone screenshots laid over it. */
	.showcase {
		position: relative;
		width: 878px;
		height: 401px;
		margin: var(--space-12) 0 0 var(--layout-inset);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--elevation-1);
	}

	.phone {
		position: absolute;
		top: 8px;
		width: 476px;
		height: 385px;
		object-fit: contain;
		pointer-events: none;
	}

	.phone-1 {
		left: -26px;
	}

	.phone-2 {
		left: 212px;
	}

	.phone-3 {
		left: 450px;
	}

	.body {
		margin-top: var(--space-16);
	}

	.gallery {
		display: grid;
		grid-template-columns: 226fr 557fr;
		gap: var(--space-3) var(--space-4);
		width: 882px;
		max-width: 100%;
		margin: var(--space-9) 0 0 var(--layout-inset);
		padding: var(--space-8) var(--space-10) var(--space-6);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--elevation-1);
	}

	.slot {
		border-radius: var(--radius-lg);
		background: var(--color-placeholder);
	}

	.slot-a {
		aspect-ratio: 1;
	}

	.slot-c {
		grid-column: 1 / -1;
		aspect-ratio: 800 / 224;
	}

	.footer-wrap {
		margin: var(--layout-footer-gap) 0 0 var(--layout-footer-inset);
		padding-bottom: var(--layout-page-bottom);
	}

	@media (max-width: 999px) {
		.text {
			width: 340px;
		}

		.showcase {
			width: 340px;
			max-width: 100%;
			height: 190px;
			margin: var(--space-9) 0 0 var(--layout-inset);
		}

		.phone {
			top: -17px;
			width: 240px;
			height: 217px;
		}

		.phone-1 {
			left: -58px;
		}

		.phone-2 {
			left: 50px;
		}

		.phone-3 {
			left: 163px;
		}

		.body {
			margin-top: var(--space-8);
		}

		.gallery {
			grid-template-columns: 103fr 200fr;
			gap: var(--space-1) var(--space-2);
			width: 347px;
			margin: var(--space-9) 0 0 var(--layout-inset);
			padding: var(--space-3) var(--space-5);
			border-radius: var(--radius-sm);
		}

		.slot {
			border-radius: var(--radius-sm);
		}

		.slot-a {
			aspect-ratio: 103 / 104;
		}

		.slot-c {
			aspect-ratio: 309 / 102;
		}
	}
</style>
