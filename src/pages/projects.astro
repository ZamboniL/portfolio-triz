---
import Footer from '../components/Footer.astro';
import PageTitle from '../components/PageTitle.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../data/projects';
import { site } from '../data/site';
import Layout from '../layouts/Layout.astro';

const projects = await getProjects();
---

<Layout title="Projects · Beatriz Mendonça" active="projects">
	<PageTitle>Projects</PageTitle>

	<p class="description">{site.projectsIntro}</p>

	<div class="grid">
		{projects.map((project) => <ProjectCard project={project} />)}
	</div>

	<div class="footer-wrap">
		<Footer />
	</div>
</Layout>

<style>
	.description {
		width: 878px;
		max-width: 100%;
		margin: var(--layout-title-gap) 0 0 var(--layout-inset);
		font-weight: var(--font-weight-light);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 310px);
		column-gap: var(--space-2);
		margin-top: var(--space-9);
	}

	.footer-wrap {
		margin: calc(var(--space-1) * 42) 0 0 var(--layout-footer-inset);
		padding-bottom: var(--layout-page-bottom);
	}

	@media (max-width: 999px) {
		/* Not in the mobile design. */
		.description {
			display: none;
		}

		.grid {
			grid-template-columns: 100%;
			justify-items: center;
			row-gap: var(--space-10);
			margin-top: var(--layout-title-gap);
		}

		.footer-wrap {
			margin-top: calc(var(--space-1) * 50);
		}
	}
</style>
