---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
const { title, year, thumbnail, thumbnailFocus } = project.data;
---

<a class="card" href={`/projects/${project.id}`}>
	<span class="card-body">
		<span class="thumb">
			{thumbnail && <img src={thumbnail} alt="" style={{ 'object-position': thumbnailFocus }} />}
		</span>
		<span class="caption">{title}, {year}</span>
	</span>
</a>

<style>
	.card {
		display: block;
		width: 310px;
		height: 393px;
		padding: var(--space-6) var(--space-2) var(--space-9);
	}

	.card-body {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-4);
		transition: transform 0.2s ease;
	}

	/* Hover = Figma "Variant2": image and caption lift 12px. */
	.card:hover .card-body,
	.card:focus-visible .card-body {
		transform: translateY(calc(-1 * var(--space-3)));
	}

	.thumb {
		position: relative;
		display: block;
		width: 292px;
		height: 292px;
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--color-placeholder);
		box-shadow: var(--elevation-1);
	}

	.thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	.caption {
		text-align: center;
		white-space: nowrap;
	}

	@media (max-width: 999px) {
		.card {
			width: 350px;
			max-width: 100%;
			height: auto;
			padding: 0;
		}

		.card-body {
			gap: var(--space-5);
		}

		.thumb {
			width: 100%;
			height: auto;
			aspect-ratio: 1;
		}

		.caption {
			font-size: var(--font-size-md);
		}
	}
</style>
