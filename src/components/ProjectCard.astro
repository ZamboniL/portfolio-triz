---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
const { image } = project;

const cropVars = image && {
	'--crop-w': image.desktop.width,
	'--crop-h': image.desktop.height,
	'--crop-l': image.desktop.left,
	'--crop-t': image.desktop.top,
	'--crop-mw': image.mobile.width,
	'--crop-mh': image.mobile.height,
	'--crop-ml': image.mobile.left,
	'--crop-mt': image.mobile.top,
};
---

<a class="card" href={`/projects/${project.slug}`}>
	<span class="card-body">
		<span class="thumb">
			{image && <img src={image.src} alt="" style={cropVars} />}
		</span>
		<span class="caption">{project.title}, {project.year}</span>
	</span>
</a>

<style>
	.card {
		display: block;
		width: 310px;
		height: 393px;
		padding: 26px 9px 37px;
	}

	.card-body {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
		transition: transform 0.2s ease;
	}

	/* Hover = Figma "Variant2": image and caption lift 12px. */
	.card:hover .card-body,
	.card:focus-visible .card-body {
		transform: translateY(-12px);
	}

	.thumb {
		position: relative;
		display: block;
		width: 292px;
		height: 292px;
		border-radius: 20px;
		overflow: hidden;
		background: var(--color-grey);
		box-shadow: 0 4px 4px 0 rgba(0, 0, 0, 0.25);
	}

	.thumb img {
		position: absolute;
		max-width: none;
		width: var(--crop-w);
		height: var(--crop-h);
		left: var(--crop-l);
		top: var(--crop-t);
		pointer-events: none;
	}

	.caption {
		text-align: center;
		white-space: nowrap;
	}

	@media (max-width: 999px) {
		.card {
			width: 350px;
			max-width: 100%;
			height: auto;
			padding: 0;
		}

		.card-body {
			gap: 20px;
		}

		.thumb {
			width: 100%;
			height: auto;
			aspect-ratio: 1;
		}

		.thumb img {
			width: var(--crop-mw);
			height: var(--crop-mh);
			left: var(--crop-ml);
			top: var(--crop-mt);
		}

		.caption {
			font-size: 16px;
		}
	}
</style>
